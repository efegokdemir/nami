{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}{% assign form_id = 'Localization-' | append: id %}{% form 'localization', id: form_id %}{% if localization.available_countries.size > 1 %}<label class="visually-hidden" for="Country-{{ id }}">Country</label><select name="country_code" id="Country-{{ id }}">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>{% endfor %}</select>{% endif %}{% if localization.available_languages.size > 1 %}<label class="visually-hidden" for="Language-{{ id }}">Language</label><select name="locale_code" id="Language-{{ id }}">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | escape }}</option>{% endfor %}</select>{% endif %}<button type="submit" class="button button--secondary">Update</button>{% endform %}{% endif %}
