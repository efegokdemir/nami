{% liquid
assign product_form_id = 'ProductForm-' | append: section.id
assign legacy_information = true
for block in section.blocks
  if block.type != 'info' and block.type != '@app'
    assign legacy_information = false
    break
  endif
endfor
%}
<div class="product-information" data-product-information>
{% if legacy_information %}{% assign default_blocks = 'vendor,title,price,description,variant_picker,quantity,buy_buttons' | split: ',' %}{% for kind in default_blocks %}<div class="product-info-block">{% render 'product-info-block', kind: kind, product: product, section: section, form_id: product_form_id, is_main: is_main %}</div>{% endfor %}{% endif %}
{% for block in section.blocks %}<div class="product-info-block" {{ block.shopify_attributes }}>{% render 'product-info-block', kind: block.type, block: block, product: product, section: section, form_id: product_form_id, is_main: is_main %}</div>{% endfor %}
{% if section.settings.details != blank %}<details class="accordion"><summary>Details</summary><div class="accordion__content">{{ section.settings.details }}</div></details>{% endif %}{% if section.settings.size_guide_page != blank %}<details class="accordion"><summary>{{ section.settings.size_guide_label | escape }}</summary><div class="accordion__content">{{ section.settings.size_guide_page.content }}</div></details>{% endif %}
{% if section.settings.sticky_atc %}<div class="sticky-atc" data-sticky-atc><span>{{ product.title | escape }}</span><button class="button button--primary" type="button" data-sticky-submit{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{{ 'products.product.add_to_cart' | t }}</button></div>{% endif %}
</div>
