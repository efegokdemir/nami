{% assign variant = product.selected_or_first_available_variant %}
{% case kind %}
{% when 'vendor' %}<p class="eyebrow">{{ product.vendor | escape }}</p>
{% when 'title' %}{% if is_main %}<h1>{{ product.title | escape }}</h1>{% else %}<h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>{% endif %}
{% when 'price' %}<div class="price" data-product-price>{{ variant.price | money }}{% if variant.compare_at_price > variant.price %}<del>{{ variant.compare_at_price | money }}</del>{% endif %}</div>
{% when 'description' %}<div class="product-description">{% if block.settings.short %}{{ product.description | strip_html | truncate: 240 }}{% else %}{{ product.description }}{% endif %}</div>
{% when 'variant_picker' %}{% unless product.has_only_default_variant %}<div class="product-options picker-{{ block.settings.picker_style | default: 'dropdown' }}">
{% for option in product.options_with_values %}<div class="product-option"><label for="Option-{{ section.id }}-{{ forloop.index }}">{{ option.name | escape }}</label><select id="Option-{{ section.id }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" data-product-option data-option-index="{{ forloop.index0 }}" form="{{ form_id }}">{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select>
{% if block.settings.picker_style != 'dropdown' and block.settings.picker_style != blank %}<div class="option-buttons" role="group" aria-label="{{ option.name | escape }}" data-option-buttons="{{ forloop.index0 }}" hidden>{% for value in option.values %}<button type="button" data-option-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"{% if block.settings.picker_style == 'swatches' and value.swatch.color != blank %} class="option-swatch" style="--swatch:{{ value.swatch.color }}"{% else %} class="option-pill"{% endif %}>{% if block.settings.picker_style == 'swatches' and value.swatch.image != blank %}{{ value.swatch.image | image_url: width: 80 | image_tag: width: 32, height: 32, alt: value.name }}{% elsif block.settings.image_swatches and value.variant.featured_image != blank %}{{ value.variant.featured_image | image_url: width: 80 | image_tag: width: 32, height: 32, alt: value.name }}{% endif %}<span{% if block.settings.picker_style == 'swatches' and value.swatch.color != blank %} class="visually-hidden"{% endif %}>{{ value | escape }}</span></button>{% endfor %}</div>{% endif %}</div>{% endfor %}</div>{% endunless %}
{% when 'quantity' %}<label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label><div class="quantity"><button type="button" data-quantity-minus aria-label="Decrease quantity">−</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" data-product-quantity form="{{ form_id }}"><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div>
{% when 'buy_buttons' %}{% form 'product', product, id: form_id, data-add-to-cart: '', data-product-form: '' %}<input type="hidden" name="id" value="{{ variant.id }}" data-variant-id><button class="button button--primary" type="submit" data-add-to-cart-button{% unless variant.available %} disabled{% endunless %}>{% if variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>{% if block.settings.dynamic_checkout or block == blank and section.settings.dynamic_checkout %}{{ form | payment_button }}{% endif %}<noscript>{% unless product.has_only_default_variant %}<label for="NoScriptVariant-{{ section.id }}">{{ 'products.product.choose_options' | t }}</label><select name="id" id="NoScriptVariant-{{ section.id }}">{% for item in product.variants %}<option value="{{ item.id }}"{% if item.id == variant.id %} selected{% endif %}{% unless item.available %} disabled{% endunless %}>{{ item.title | escape }} — {{ item.price | money }}</option>{% endfor %}</select>{% endunless %}</noscript>{% endform %}
{% when 'inventory' %}<p data-product-inventory data-show-count="{{ block.settings.show_count }}">{% if variant.available %}{% if block.settings.show_count and variant.inventory_management and variant.inventory_quantity > 0 %}{{ variant.inventory_quantity }} available{% else %}In stock{% endif %}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</p>
{% when 'sku' %}<p data-product-sku>{{ 'products.product.sku' | t }}: {{ variant.sku | escape }}</p>
{% when 'info' %}{% if block.settings.content != blank or block.settings.page != blank or request.design_mode %}<details class="accordion"><summary>{{ block.settings.heading | escape }}</summary><div class="accordion__content">{{ block.settings.content }}{{ block.settings.page.content }}</div></details>{% endif %}
{% when 'popup' %}{% if block.settings.page != blank %}<details class="accordion"><summary>{{ block.settings.label | escape }}</summary><div class="accordion__content">{{ block.settings.page.content }}</div></details>{% endif %}
{% when 'custom_liquid' %}{{ block.settings.custom_liquid }}
{% when 'complementary' %}<div data-product-recommendations data-product-id="{{ product.id }}" data-intent="complementary" data-limit="{{ block.settings.limit }}"><h3>{{ block.settings.heading | escape }}</h3><div class="merch-grid" data-recommendations-grid></div></div>
{% when 'share' %}<button class="button button--link" type="button" data-share-url="{{ shop.url }}{{ product.url }}" data-share-title="{{ product.title | escape }}">{{ 'products.product.share' | t }}</button>
{% when '@app' %}{% render block %}
{% endcase %}
