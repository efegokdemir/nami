{% liquid
  assign hero_image = section.settings.image | default: section.settings.mobile_image
  assign has_media = false
  if hero_image != blank or section.settings.video != blank
    assign has_media = true
  endif
  assign layout = section.settings.layout | default: 'split'
  assign auto_contrast = false
  assign scheme_id = section.settings.color_scheme | append: ''
  if has_media and layout != 'split'
    if scheme_id == blank or scheme_id == 'scheme-1'
      assign auto_contrast = true
    endif
  endif
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign media_position = section.settings.media_position
  if legacy and section.settings.reverse
    assign media_position = 'right'
  endif
%}
{% if has_media or section.settings.heading != blank or section.settings.text != blank or request.design_mode %}
<section class="section hero capability-hero capability-hero--{{ layout }}{% if auto_contrast %} capability-hero--auto-contrast{% endif %}{% unless has_media %} capability-hero--empty{% endunless %} color-{{ section.settings.color_scheme }}" style="--hero-height:{{ section.settings.height | default: 420 }}px;--hero-mobile-height:{{ section.settings.mobile_height | default: 240 }}px;--hero-text-width:{{ section.settings.text_width | default: 560 }}px;--hero-overlay:{{ section.settings.overlay | divided_by: 100.0 }};--hero-overlay-color:{{ section.settings.overlay_color }};--hero-position:{{ section.settings.image_position }};--hero-valign:{{ section.settings.vertical_alignment | default: 'center' }}">
  <div class="page-width capability-hero__layout{% if media_position == 'right' %} media-right{% endif %} mobile-media-{{ section.settings.mobile_order }} height-{{ section.settings.height_mode | default: 'fixed' }}">
    {% if has_media %}<div class="capability-hero__media"{% if section.settings.autoplay %} data-autoplay-video{% endif %}>
      {% if section.settings.video != blank %}{{ section.settings.video | video_tag: image_size: '1600x', autoplay: false, loop: section.settings.loop, muted: true, controls: section.settings.controls }}
      {% else %}<picture>{% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ hero_image | image_url: width: 2000 | image_tag: widths: '480,750,1100,1500,2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}</picture>{% endif %}
      {% if section.settings.overlay_enabled %}<div class="capability-hero__overlay" aria-hidden="true"></div>{% endif %}
    </div>{% endif %}
    <div class="capability-hero__content align-{{ section.settings.alignment }} mobile-align-{{ section.settings.mobile_alignment }}">
      {% if section.settings.badge != blank %}<span class="content-badge">{{ section.settings.badge | escape }}</span>{% endif %}
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<{{ heading_tag }}>{{ section.settings.heading | escape }}</{{ heading_tag }}>{% endif %}
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
      <div class="hero__actions">{% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="button button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}{% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}</div>
      {% if request.design_mode and has_media == false and section.settings.heading == blank and section.settings.text == blank %}<p class="editor-help">Add hero content.</p>{% endif %}
    </div>
  </div>
</section>{% endif %}
