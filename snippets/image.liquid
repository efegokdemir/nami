{% if image != blank %}
  {% liquid
    assign image_width = width | default: 1200
    assign image_sizes = sizes | default: '100vw'
    assign image_loading = loading | default: 'lazy'
    assign image_priority = fetchpriority | default: 'auto'
  %}
  {{ image | image_url: width: image_width | image_tag: widths: '320,480,750,1000,1200,1600', sizes: image_sizes, loading: image_loading, fetchpriority: image_priority, class: class, alt: image.alt }}
{% else %}<div class="media-empty" aria-hidden="true">{% if request.design_mode %}<span class="media-empty__hint">Add an image</span>{% endif %}</div>{% endif %}
