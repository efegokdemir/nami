<article class="product-card">
  <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if product.featured_media %}{{ product.featured_media.preview_image | image_url: width: 800 | image_tag: widths: '320,480,640,800', sizes: '(min-width: 990px) 25vw, 50vw', loading: loading | default: 'lazy', class: 'product-card__image' }}{% else %}<div class="media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}
    {% if product.compare_at_price > product.price %}<span class="badge">{{ 'products.product.on_sale' | t }}</span>{% endif %}
    {% unless product.available %}<span class="badge badge--muted">{{ 'products.product.sold_out' | t }}</span>{% endunless %}
  </a>
  <div class="product-card__content">
    {% if show_vendor and product.vendor != blank %}<p class="eyebrow">{{ product.vendor }}</p>{% endif %}
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="price">{% if product.price_varies %}<span>{{ 'products.product.from' | t }} </span>{% endif %}{{ product.price | money }} {% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}</div>
  </div>
</article>
