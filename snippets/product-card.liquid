{% liquid
assign card_ratio = image_ratio | default: 'portrait'
assign chosen_variant = product.selected_or_first_available_variant
assign quick_form_id = 'QuickAdd-' | append: section.id | append: product.id | append: card_context
%}<article class="product-card product-card--{{ card_style | default: 'plain' }} align-{{ card_alignment | default: 'left' }}">
<a class="product-card__media ratio-{{ card_ratio }}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
{% if product.featured_media %}{% render 'image', image: product.featured_media.preview_image, width: 800, sizes: '(min-width:990px) 25vw,50vw', class: 'product-card__image' %}{% if show_second_image != false and product.media[1].media_type == 'image' %}{% render 'image', image: product.media[1].preview_image, width: 800, sizes: '(min-width:990px) 25vw,50vw', class: 'product-card__image product-card__image--secondary' %}{% endif %}{% else %}<div class="media-empty" aria-hidden="true"></div>{% endif %}
{% if show_badges != false %}{% if product.compare_at_price > product.price %}<span class="badge">{{ 'products.product.on_sale' | t }}</span>{% endif %}{% unless product.available %}<span class="badge badge--muted">{{ 'products.product.sold_out' | t }}</span>{% endunless %}{% endif %}</a>
<div class="product-card__content">{% if show_vendor %}<p class="eyebrow">{{ product.vendor | escape }}</p>{% endif %}<h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>{% if show_price != false %}<div class="price">{% if product.price_varies %}<span>{{ 'products.product.from' | t }}</span>{% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}</div>{% endif %}
{% if show_swatches %}<div class="card-swatches">{% for option in product.options_with_values %}{% for value in option.values %}{% if value.swatch != blank %}<a class="option-swatch" href="{{ product.url }}?variant={{ value.variant.id }}" aria-label="{{ option.name | escape }}: {{ value | escape }}" title="{{ value | escape }}" style="{% if value.swatch.color %}--swatch:{{ value.swatch.color }};{% endif %}">{% if value.swatch.image %}{{ value.swatch.image | image_url: width: 64 | image_tag: width: 24, height: 24, alt: value.name }}{% endif %}</a>{% endif %}{% endfor %}{% endfor %}</div>{% endif %}
{% if show_quick_add != false %}{% if product.has_only_default_variant and product.selling_plan_groups == empty %}{% form 'product', product, id: quick_form_id, class: 'card-quick-add', data-add-to-cart: '' %}<input type="hidden" name="id" value="{{ chosen_variant.id }}"><button class="button button--secondary" type="submit"{% unless chosen_variant.available %} disabled{% endunless %}>{% if chosen_variant.available %}{{ 'products.product.quick_add' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>{% endform %}{% else %}<a class="button button--secondary card-quick-add" href="{{ product.url }}">{{ 'products.product.choose_options' | t }}</a>{% endif %}{% endif %}</div></article>
