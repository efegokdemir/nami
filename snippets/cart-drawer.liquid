<aside class="drawer" data-cart-drawer aria-hidden="true"><div class="drawer__scrim"></div><div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle"><div class="drawer__header"><h2 id="CartDrawerTitle">{{ 'cart.general.title' | t }}</h2><button class="icon-button" type="button" data-cart-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span></button></div><div class="drawer__body" data-cart-body></div><div class="drawer__footer"><div class="cart-total"><span>{{ 'cart.general.subtotal' | t }}</span><span data-cart-total>{{ cart.total_price | money }}</span></div><div class="cart-footer-actions"><a class="button button--primary" href="{{ routes.cart_url }}">{{ 'cart.general.checkout' | t }}</a><a class="button button--secondary" href="{{ routes.cart_url }}">View cart</a></div></div></div></aside>
