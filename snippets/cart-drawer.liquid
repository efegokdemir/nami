<aside class="drawer" data-cart-drawer aria-hidden="true"><div class="drawer__scrim"></div><div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle"><div class="drawer__header"><h2 id="CartDrawerTitle">{{ 'cart.general.title' | t }}</h2><button class="icon-button" type="button" data-cart-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span></button></div><div class="drawer__body" data-cart-body></div><div class="drawer__footer"><div class="cart-total"><span>{{ 'cart.general.subtotal' | t }}</span><span data-cart-total>{{ cart.total_price | money }}</span></div><p class="utility-text">{{ 'cart.general.shipping_at_checkout' | t }}</p><p class="cart-shipping-progress" data-shipping-progress hidden></p>{% if settings.cart_note %}<div class="cart-note-field"><label for="DrawerNote">{{ 'cart.general.note' | t }}</label><textarea id="DrawerNote" name="note" form="DrawerCheckout" data-cart-note rows="2">{{ cart.note | escape }}</textarea></div>{% endif %}<div class="cart-footer-actions"><form id="DrawerCheckout" action="{{ routes.cart_url }}" method="post"><button class="button button--primary" type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button></form><a class="text-link" href="{{ routes.cart_url }}">View cart</a><button class="text-link" type="button" data-cart-close>{{ 'cart.general.continue_shopping' | t }}</button></div></div></div></aside>
