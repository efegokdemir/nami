<div class="product-media product-media--{{ section.settings.gallery_layout | default: 'stacked' }}">
{% if section.settings.gallery_layout == 'thumbnails' and product.media.size > 0 %}<nav class="gallery-thumbnails" aria-label="Product media">{% for media in product.media %}<a href="#Media-{{ section.id }}-{{ media.id }}" aria-label="Media {{ forloop.index }}">{{ media.preview_image | image_url: width: 160 | image_tag: width: 64, height: 64, loading: 'lazy' }}</a>{% endfor %}</nav>{% endif %}
<div class="product-gallery"{% if section.settings.gallery_layout != 'stacked' and product.media.size > 0 %} tabindex="0" role="region" aria-label="Product media"{% endif %}>{% for media in product.media %}<div id="Media-{{ section.id }}-{{ media.id }}" data-media-id="{{ media.id }}" class="product-gallery__item">{% if media.media_type == 'image' %}{% render 'image', image: media.preview_image, width: 1400, sizes: '(min-width:750px) 60vw,100vw' %}{% elsif media.media_type == 'external_video' %}{% assign media_title = media.alt | default: product.title %}{{ media | external_video_tag: title: media_title, loading: 'lazy' }}{% else %}{{ media | media_tag: image_size: '1200x', controls: true, preload: 'none' }}{% endif %}</div>{% else %}{% render 'image' %}{% endfor %}</div></div>
