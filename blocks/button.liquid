{% if block.settings.link != blank or request.design_mode %}<div class="theme-block theme-block--button" {{ block.shopify_attributes }}><a class="button button--{{ block.settings.style }}" href="{{ block.settings.link }}">{{ block.settings.label }}</a></div>
{% endif %}
{% schema %}{"name":"Button","settings":[{"type":"text","id":"label","label":"Label"},{"type":"url","id":"link","label":"Link"},{"type":"select","id":"style","label":"Style","options":[{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"},{"value":"link","label":"Text link"}]}],"presets":[{"name":"Button"}]}{% endschema %}
