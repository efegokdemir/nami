{% if block.settings.quote != blank or request.design_mode %}<figure class="theme-block theme-block--quote" {{ block.shopify_attributes }}><blockquote>“{{ block.settings.quote }}”</blockquote><figcaption>{{ block.settings.author }}</figcaption></figure>
{% endif %}
{% schema %}{"name":"Quote","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"author","label":"Author"}],"presets":[{"name":"Quote"}]}{% endschema %}
