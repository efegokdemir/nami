<figure class="theme-block theme-block--quote" {{ block.shopify_attributes }}><blockquote>“{{ block.settings.quote }}”</blockquote><figcaption>{{ block.settings.author }}</figcaption></figure>
{% schema %}{"name":"Quote","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"A real customer quote belongs here."},{"type":"text","id":"author","label":"Author","default":"Customer name"}],"presets":[{"name":"Quote"}]}{% endschema %}
