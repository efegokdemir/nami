<div class="feature-icon" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{% render 'image', image: block.settings.image, width: 120 %}{% else %}{% render 'icon', name: block.settings.icon %}{% endif %}</div>
{% schema %}{"name":"Icon","settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"shipping","label":"Delivery"},{"value":"return","label":"Returns"},{"value":"support","label":"Support"},{"value":"check","label":"Check"},{"value":"lock","label":"Secure"}],"default":"check"},{"type":"image_picker","id":"image","label":"Custom icon"}],"presets":[{"name":"Icon"}]}{% endschema %}
