<section class="section"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">Search</p><h1>Find your next favorite.</h1></div></div><form action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchInput">{{ 'general.search.search' | t }}</label><input class="search-input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}"></form>{% if search.performed %}{% if search.results_count > 0 %}<div class="grid grid--products" style="margin-top:2rem">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article class="card"><p class="eyebrow">{{ item.object_type }}</p><h2><a href="{{ item.url }}">{{ item.title }}</a></h2></article>{% endif %}{% endfor %}</div>{% else %}<div class="card" style="margin-top:2rem"><p>{{ 'general.search.no_results' | t }}</p></div>{% endif %}{% endif %}</div></section>
{% schema %}{"name":"Search results","settings":[],"presets":[{"name":"Search results"}]}{% endschema %}
