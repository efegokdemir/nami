<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></div><div class="grid grid--columns">{% for block in section.blocks %}<article class="card" {{ block.shopify_attributes }}><p class="eyebrow">{{ block.settings.number }}</p><h3>{{ block.settings.heading }}</h3><div>{{ block.settings.text }}</div>{% if block.settings.link_label != blank %}<a class="button button--link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>{% endif %}</article>{% endfor %}</div></div></section>
{% schema %}{"name":"Multi-column","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Nami approach"},{"type":"text","id":"heading","label":"Heading","default":"Simple, by design."},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}],"blocks":[{"type":"column","name":"Column","settings":[{"type":"text","id":"number","label":"Label"},{"type":"text","id":"heading","label":"Heading","default":"Clarity"},{"type":"richtext","id":"text","label":"Text","default":"<p>Give each idea room to breathe.</p>"},{"type":"text","id":"link_label","label":"Link label"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Multi-column","blocks":[{"type":"column"},{"type":"column"},{"type":"column"}]}]}{% endschema %}
