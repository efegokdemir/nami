<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div><div class="grid grid--columns">{% for block in section.blocks %}{% assign collection = block.settings.collection %}{% if collection != blank %}<a class="card collection-card" href="{{ collection.url }}" {{ block.shopify_attributes }}>{% if collection.image %}{{ collection.image | image_url: width: 900 | image_tag: widths: '320,640,900', sizes: '(min-width: 750px) 33vw, 100vw', alt: collection.title }}{% endif %}<h3>{{ collection.title }}</h3><p>{{ collection.products_count }} products</p></a>{% else %}<div class="card" {{ block.shopify_attributes }}>Choose a collection.</div>{% endif %}{% endfor %}</div></div></section>
{% schema %}{"name":"Collection cards","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore collections"}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"}]}],"presets":[{"name":"Collection cards","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}{% endschema %}
