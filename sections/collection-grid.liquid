<section class="section section--compact collection-cards-section"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div><p>{{ section.settings.text }}</p></div><div class="grid grid--columns">{% for block in section.blocks %}{% assign collection = block.settings.collection %}{% if collection != blank %}<a class="card collection-card" href="{{ collection.url }}" {{ block.shopify_attributes }}>{% if collection.image %}{{ collection.image | image_url: width: 900 | image_tag: widths: '320,640,900', sizes: '(min-width: 750px) 33vw, 100vw', alt: collection.title }}{% else %}<div class="collection-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>{% endif %}<div class="collection-card__content"><p class="eyebrow">{{ collection.products_count }} products</p><h3>{{ collection.title }}</h3><span class="text-link">Shop the edit {% render 'icon', name: 'arrow' %}</span></div></a>{% else %}<a class="card collection-card collection-card--placeholder" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="collection-card__placeholder">{{ block.settings.icon }}</div><div class="collection-card__content"><p class="eyebrow">{{ block.settings.eyebrow }}</p><h3>{{ block.settings.label }}</h3><p>{{ block.settings.description }}</p><span class="text-link">Explore {% render 'icon', name: 'arrow' %}</span></div></a>{% endif %}{% endfor %}</div></div></section>
{% schema %}{"name":"Collection cards","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Find your starting point"},{"type":"text","id":"heading","label":"Heading","default":"Shop by intention"},{"type":"textarea","id":"text","label":"Supporting text","default":"A few considered places to begin."}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The edit"},{"type":"text","id":"label","label":"Placeholder title","default":"Everyday essentials"},{"type":"textarea","id":"description","label":"Placeholder description","default":"A thoughtful mix for daily life."},{"type":"text","id":"icon","label":"Placeholder mark","default":"01"},{"type":"url","id":"link","label":"Placeholder link"}]}],"presets":[{"name":"Collection cards","blocks":[{"type":"collection","settings":{"eyebrow":"01 / New","label":"New arrivals","description":"Fresh ideas for the everyday.","icon":"01"}},{"type":"collection","settings":{"eyebrow":"02 / Home","label":"The home edit","description":"Useful objects, chosen well.","icon":"02"}},{"type":"collection","settings":{"eyebrow":"03 / Daily","label":"Small rituals","description":"Simple things that make a difference.","icon":"03"}}]}]}{% endschema %}
