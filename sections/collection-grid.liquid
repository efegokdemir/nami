{% assign meaningful_blocks = 0 %}{% for block in section.blocks %}{% if block.settings.collection != blank or block.settings.link != blank %}{% assign meaningful_blocks = meaningful_blocks | plus: 1 %}{% endif %}{% endfor %}{% if meaningful_blocks > 0 or request.design_mode %}
{% render 'section-style', section: section %}
{% if section.blocks.size > 0 or request.design_mode %}<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width" data-carousel><div class="section-heading"><div><h2>{{ section.settings.heading | escape }}</h2>{{ section.settings.text }}</div>{% if section.settings.show_view_all %}<a class="text-link" href="{{ routes.collections_url }}">{{ section.settings.link_label | escape }}</a>{% endif %}{% if section.settings.layout == 'carousel' %}<div class="carousel-controls"><button class="icon-button" type="button" data-carousel-prev aria-label="Previous items">←</button><button class="icon-button" type="button" data-carousel-next aria-label="Next items">→</button></div>{% endif %}</div><div class="merch-grid merch-grid--{{ section.settings.layout }}" style="--desktop-columns:{{ section.settings.desktop_columns }};--mobile-columns:{{ section.settings.mobile_columns }}"{% if section.settings.layout == 'carousel' %} data-carousel-track tabindex="0" role="region" aria-label="Collections"{% endif %}>
{% for block in section.blocks %}{% liquid
assign chosen = block.settings.collection
assign tile_image = block.settings.image | default: chosen.image
assign title = block.settings.label | default: chosen.title
assign tile_url = block.settings.link | default: chosen.url
%}{% if tile_url != blank or request.design_mode %}<article class="collection-tile collection-tile--{{ section.settings.presentation }} align-{{ section.settings.content_alignment }}" {{ block.shopify_attributes }}><div class="collection-tile__media ratio-{{ section.settings.image_ratio }}">{% render 'image', image: tile_image, width: 900 %}</div><div class="collection-tile__content"><h3>{% if tile_url != blank %}<a href="{{ tile_url }}">{{ title | escape }}</a>{% else %}{{ title | escape }}{% endif %}</h3>{% if tile_url == blank and request.design_mode %}<p class="editor-help">Choose a collection or add a link.</p>{% endif %}{{ block.settings.description }}</div></article>{% endif %}{% endfor %}</div></div></section>{% endif %}

{% endif %}
{% schema %}
{
  "name": "Collection cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting text"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image proportions",
      "options": [
        {
          "value": "natural",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "presentation",
      "label": "Text placement",
      "options": [
        {
          "value": "below",
          "label": "Below image"
        },
        {
          "value": "overlay",
          "label": "Over image"
        }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all",
      "default": false
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "section_alignment",
      "label": "Section alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "spacious",
          "label": "Spacious"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection cards",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
