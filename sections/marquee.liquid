{% assign meaningful = 0 %}{% for block in section.blocks %}{% if block.settings.text != blank or block.settings.icon != 'none' and block.settings.icon != blank %}{% assign meaningful = meaningful | plus: 1 %}{% endif %}{% endfor %}
{% if meaningful > 0 or section.settings.text != blank or request.design_mode %}{% render 'section-style', section: section %}<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width"><div class="capability-marquee{% if section.settings.pause_hover %} marquee-animated{% endif %}" data-marquee style="--marquee-speed:{{ section.settings.speed }}s;--marquee-direction:{{ section.settings.direction }}">
{% if section.settings.pause_hover and meaningful > 0 or section.settings.pause_hover and section.settings.text != blank %}<button class="marquee-pause" type="button" data-marquee-pause aria-pressed="false" hidden>Pause animation</button>{% endif %}
<div class="capability-marquee__track">{% for copy in (1..2) %}<div class="capability-marquee__group"{% if copy == 2 %} aria-hidden="true" inert{% endif %}>{% if meaningful > 0 %}{% for block in section.blocks %}{% if block.settings.text != blank or block.settings.icon != 'none' and block.settings.icon != blank %}<span{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}{% render 'icon', name: block.settings.icon %}{{ block.settings.text | escape }}{% if block.settings.link != blank %}</a>{% endif %}</span>{% endif %}{% endfor %}{% elsif section.settings.text != blank %}<span>{{ section.settings.text | escape }}</span>{% elsif request.design_mode and copy == 1 %}<p class="editor-help">Add a message.</p>{% endif %}</div>{% endfor %}</div></div></div></section>{% endif %}
{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Legacy text"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per cycle",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s",
      "visible_if": "{{ section.settings.pause_hover }}"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "normal",
          "label": "Left"
        },
        {
          "value": "reverse",
          "label": "Right"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.pause_hover }}"
    },
    {
      "type": "checkbox",
      "id": "pause_hover",
      "label": "Animate messages",
      "default": false,
      "info": "Animated messages always pause on hover/focus and include a pause button. Previously this setting controlled hover pause; off now uses a static layout."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Standard"
        },
        {
          "value": "spacious",
          "label": "Generous"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "compact"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "shipping",
              "label": "Delivery"
            }
          ],
          "default": "none"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
