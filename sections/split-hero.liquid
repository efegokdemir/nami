{% render 'section-style', section: section %}
<section class="section split split--hero color-{{ section.settings.color_scheme }}{% if section.settings.reverse %} split--reverse{% endif %}"><div class="page-width split"><div class="split__media">{% render 'image', image: section.settings.image, width: 1200, sizes: '(min-width: 750px) 50vw, 100vw', loading: 'eager' %}</div><div class="split__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><div>{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Split hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Split hero"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "spacious",
          "label": "Spacious"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Split hero"
    }
  ]
}
{% endschema %}
