<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div><div class="before-after"><div class="before-after__panel">{% render 'image', image: section.settings.before_image, width: 1200, sizes: '(min-width: 750px) 50vw, 100vw' %}<span>{{ section.settings.before_label }}</span></div><div class="before-after__panel">{% render 'image', image: section.settings.after_image, width: 1200, sizes: '(min-width: 750px) 50vw, 100vw' %}<span>{{ section.settings.after_label }}</span></div></div></div></section>
{% schema %}{"name":"Before and after","settings":[{"type":"text","id":"heading","label":"Heading","default":"The difference is in the detail."},{"type":"image_picker","id":"before_image","label":"Before image"},{"type":"text","id":"before_label","label":"Before label","default":"Before"},{"type":"image_picker","id":"after_image","label":"After image"},{"type":"text","id":"after_label","label":"After label","default":"After"}],"presets":[{"name":"Before and after"}]}{% endschema %}
