<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div><div class="bento-grid">{% for block in section.blocks %}<article class="card bento-grid__item bento-grid__item--{{ block.settings.size }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '320,640,1000', sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.heading }}{% endif %}<div><p class="eyebrow">{{ block.settings.eyebrow }}</p><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Bento grid","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"Heading","default":"A little more character."}],"blocks":[{"type":"tile","name":"Tile","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"size","label":"Tile size","options":[{"value":"standard","label":"Standard"},{"value":"wide","label":"Wide"},{"value":"tall","label":"Tall"}],"default":"standard"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"A detail worth noticing"},{"type":"textarea","id":"text","label":"Text","default":"Tell a concise story."}]}],"presets":[{"name":"Bento grid","blocks":[{"type":"tile"},{"type":"tile"},{"type":"tile"}]}]}{% endschema %}
