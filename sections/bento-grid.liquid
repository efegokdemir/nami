{% assign meaningful_blocks = 0 %}{% for block in section.blocks %}{% if block.settings.heading != blank or block.settings.text != blank or block.settings.image != blank or block.settings.product != blank or block.settings.collection != blank %}{% assign meaningful_blocks = meaningful_blocks | plus: 1 %}{% endif %}{% endfor %}{% if meaningful_blocks > 0 or request.design_mode %}
{% render 'section-style', section: section %}
{% if section.blocks.size > 0 or request.design_mode %}<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2></div><div class="capability-bento" style="--bento-columns:{{ section.settings.columns }};--bento-row-height:{{ section.settings.row_height }}px">
{% for block in section.blocks %}{% liquid
assign tile_resource = block.settings.product | default: block.settings.collection
assign tile_image = block.settings.image | default: tile_resource.featured_image | default: tile_resource.image
assign tile_title = block.settings.heading | default: tile_resource.title
assign tile_url = block.settings.link | default: tile_resource.url
%}{% if tile_title != blank or tile_image != blank or block.settings.text != blank or request.design_mode %}<article class="bento-tile bento-tile--{{ block.settings.size }}{% if tile_image != blank %} bento-tile--{{ block.settings.presentation }}{% else %} bento-tile--content{% endif %} color-{{ block.settings.color_scheme }} align-{{ block.settings.alignment }}" {{ block.shopify_attributes }} style="--tile-overlay:{{ block.settings.overlay | divided_by: 100.0 }}">
{% if tile_image != blank %}<div class="bento-tile__media"><picture>{% if block.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">{% endif %}{% render 'image', image: tile_image, width: 1400 %}</picture></div>{% elsif request.design_mode %}{% render 'image' %}{% endif %}<div class="bento-tile__content">{% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}<h3>{% if tile_url != blank %}<a href="{{ tile_url }}">{{ tile_title | escape }}</a>{% else %}{{ tile_title | escape }}{% endif %}</h3>{{ block.settings.text }}{% if block.settings.product != blank %}<div class="price">{{ block.settings.product.price | money }}</div>{% endif %}</div></article>{% endif %}{% endfor %}
</div></div></section>{% endif %}

{% endif %}
{% schema %}
{
  "name": "Bento grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Standard tile height",
      "min": 200,
      "max": 400,
      "step": 20,
      "default": 200,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "section_alignment",
      "label": "Section alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Standard"
        },
        {
          "value": "spacious",
          "label": "Generous"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Bento item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Optional. Replaces the selected product or collection image."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image override",
          "visible_if": "{{ block.settings.image != blank or block.settings.product != blank or block.settings.collection != blank }}"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product (takes priority)",
          "info": "Uses this product's title, link and price. Clear it to use a collection or your own content."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection fallback",
          "info": "Used only when no product is selected. Your heading, image and link can override the selected resource."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading override"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Item size",
          "visible_if": "{{ block.settings.image != blank or block.settings.product != blank or block.settings.collection != blank }}",
          "options": [
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "wide",
              "label": "Wide"
            },
            {
              "value": "tall",
              "label": "Tall"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "standard"
        },
        {
          "type": "select",
          "id": "presentation",
          "label": "Text placement",
          "options": [
            {
              "value": "below",
              "label": "Below image"
            },
            {
              "value": "overlay",
              "label": "Over image"
            }
          ],
          "default": "below",
          "visible_if": "{{ block.settings.image != blank or block.settings.product != blank or block.settings.collection != blank }}"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Text alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Media overlay",
          "min": 0,
          "max": 90,
          "step": 5,
          "default": 30,
          "unit": "%",
          "visible_if": "{{ block.settings.presentation == 'overlay' and block.settings.image != blank or block.settings.presentation == 'overlay' and block.settings.product != blank or block.settings.presentation == 'overlay' and block.settings.collection != blank }}"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Text color scheme",
          "default": "scheme-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mixed bento",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "size": "large"
          }
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    },
    {
      "name": "Three equal tiles",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
