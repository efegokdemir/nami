<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></div><div class="feature-list">{% for block in section.blocks %}<article class="feature-list__item" {{ block.shopify_attributes }}><span class="eyebrow">{{ block.settings.icon }}</span><h3>{{ block.settings.heading }}</h3><div>{{ block.settings.text }}</div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Features","max_blocks":8,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Why it works"},{"type":"text","id":"heading","label":"Heading","default":"Thoughtful from every angle"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}],"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"text","id":"icon","label":"Icon or label","default":"✦"},{"type":"text","id":"heading","label":"Heading","default":"Considered"},{"type":"richtext","id":"text","label":"Text","default":"<p>Explain a useful benefit clearly.</p>"}]}],"presets":[{"name":"Features","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]}{% endschema %}
