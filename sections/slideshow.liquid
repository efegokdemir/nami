{% assign slide_count = 0 %}{% for block in section.blocks %}{% if block.settings.image != blank or block.settings.heading != blank or block.settings.text != blank %}{% assign slide_count = slide_count | plus: 1 %}{% endif %}{% endfor %}
{% if slide_count > 0 or request.design_mode %}{% render 'section-style', section: section %}<section class="section slideshow" data-carousel><div class="page-width">{% if slide_count > 1 %}<div class="carousel-controls"><button type="button" data-carousel-prev aria-label="Previous slide">←</button><button type="button" data-carousel-next aria-label="Next slide">→</button></div>{% endif %}<div class="slideshow__track" data-carousel-track tabindex="0" role="region" aria-label="Slideshow">{% for block in section.blocks %}{% if block.settings.image != blank or block.settings.heading != blank or block.settings.text != blank %}<article class="slideshow__slide" {{ block.shopify_attributes }}><div class="split{% if block.settings.image == blank %} split--text-only{% endif %}">{% if block.settings.image != blank %}<div class="split__media">{% render 'image', image: block.settings.image, width: 1200, sizes: '(min-width: 750px) 50vw, 100vw' %}</div>{% endif %}<div class="split__content"><p class="eyebrow">{{ block.settings.eyebrow | escape }}</p><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p>{% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="button button--secondary" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}</div></div></article>{% endif %}{% endfor %}</div>{% if slide_count == 0 and request.design_mode %}<p class="editor-help">Add slide content.</p>{% endif %}</div></section>{% endif %}
{% schema %}
{
  "name": "Slideshow",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Standard"
        },
        {
          "value": "spacious",
          "label": "Generous"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A new perspective"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
