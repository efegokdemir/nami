<section class="section section--tight"><div class="page-width"><p class="eyebrow">{{ section.settings.heading }}</p><div class="logo-list">{% for block in section.blocks %}<div class="logo-list__item" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 320 | image_tag: widths: '160,320', sizes: '160px', alt: block.settings.alt }}{% else %}{{ block.settings.text }}{% endif %}</div>{% endfor %}</div></div></section>
{% schema %}{"name":"Logo list","max_blocks":10,"settings":[{"type":"text","id":"heading","label":"Heading","default":"In good company"}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"image","label":"Logo"},{"type":"text","id":"text","label":"Text fallback","default":"Studio"},{"type":"text","id":"alt","label":"Alt text","default":"Partner logo"}]}],"presets":[{"name":"Logo list","blocks":[{"type":"logo"},{"type":"logo"},{"type":"logo"}]}]}{% endschema %}
