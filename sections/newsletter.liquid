<section class="section newsletter"><div class="page-width newsletter__inner"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="form-row"><label class="visually-hidden" for="NewsletterEmail">Email</label><input id="NewsletterEmail" type="email" name="contact[email]" required placeholder="{{ section.settings.placeholder }}"><button class="button button--primary" type="submit">{{ section.settings.button_label }}</button></div>{% if form.posted_successfully? %}<p role="status">{{ 'sections.newsletter.success' | t }}</p>{% endif %}{% endform %}</div></section>
{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A little note"},{"type":"text","id":"heading","label":"Heading","default":"Stay in the know"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Email address"},{"type":"text","id":"button_label","label":"Button label","default":"Subscribe"}],"presets":[{"name":"Newsletter"}]}{% endschema %}
