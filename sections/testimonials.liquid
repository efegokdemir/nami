<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div><div class="grid grid--columns">{% for block in section.blocks %}<figure class="card" {{ block.shopify_attributes }}><blockquote>“{{ block.settings.quote }}”</blockquote><figcaption>{{ block.settings.author }}{% if block.settings.detail != blank %}<span> · {{ block.settings.detail }}</span>{% endif %}</figcaption></figure>{% endfor %}</div></div></section>
{% schema %}{"name":"Testimonials","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Kind words"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"}],"blocks":[{"type":"quote","name":"Quote","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"Add a real customer quote here."},{"type":"text","id":"author","label":"Name","default":"Customer name"},{"type":"text","id":"detail","label":"Detail"}]}],"presets":[{"name":"Testimonials","blocks":[{"type":"quote"},{"type":"quote"}]}]}{% endschema %}
