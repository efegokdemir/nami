{% render 'section-style', section: section %}
{% assign real_quotes = 0 %}{% for block in section.blocks %}{% if block.settings.quote != blank %}{% assign real_quotes = real_quotes | plus: 1 %}{% endif %}{% endfor %}{% if real_quotes > 0 or request.design_mode %}<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2></div><div class="testimonials layout-{{ section.settings.layout }}">{% for block in section.blocks %}{% if block.settings.quote != blank %}<figure {{ block.shopify_attributes }}><blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{% if block.settings.avatar != blank %}{{ block.settings.avatar | image_url: width: 100 | image_tag: width: 48, height: 48, loading: 'lazy' }}{% endif %}<span>{{ block.settings.author | escape }}{% if block.settings.detail != blank %} · {{ block.settings.detail | escape }}{% endif %}</span>{% if block.settings.rating > 0 %}<span aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}<span aria-hidden="true">★</span>{% endfor %}</span>{% endif %}</figcaption></figure>{% elsif request.design_mode %}<p class="editor-help" {{ block.shopify_attributes }}>Add an authentic customer quote.</p>{% endif %}{% endfor %}</div></div></section>{% endif %}
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        },
        {
          "value": "featured",
          "label": "Featured quote"
        }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "section_alignment",
      "label": "Section alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "spacious",
          "label": "Spacious"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Role or company"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating (0 hides rating)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
