{% assign featured = section.settings.product %}<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width split">{% if featured != blank %}<div class="split__media">{% render 'image', image: featured.featured_media.preview_image, width: 1200, sizes: '(min-width: 750px) 50vw, 100vw' %}</div><div class="split__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ featured.title }}</h2><div class="price">{{ featured.price | money }}</div><p>{{ featured.description | strip_html | truncate: 180 }}</p><a class="button button--primary" href="{{ featured.url }}">{{ section.settings.button_label }}</a></div>{% else %}<div class="card" style="grid-column:1/-1">Choose a product to feature.</div>{% endif %}</div></section>
{% schema %}{"name":"Featured product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The one to know"},{"type":"text","id":"button_label","label":"Button label","default":"View product"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"}],"presets":[{"name":"Featured product"}]}{% endschema %}
