{% render 'section-style', section: section %}
<section class="section cart-page"><div class="page-width"><div class="section-heading"><h1>{{ 'cart.general.title' | t }}</h1></div>{% if cart.item_count > 0 %}<form class="cart-page-layout" action="{{ routes.cart_url }}" method="post"><div class="cart-page-lines">{% for item in cart.items %}<div class="cart-line">{% if item.image != blank %}<a href="{{ item.url }}" tabindex="-1" aria-hidden="true">{{ item.image | image_url: width: 240 | image_tag: width: 120, height: 150, alt: item.image.alt }}</a>{% else %}<span aria-hidden="true"></span>{% endif %}<div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% if settings.cart_vendor and item.product.vendor != blank %}<p class="eyebrow">{{ item.product.vendor | escape }}</p>{% endif %}{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% if settings.cart_properties %}<dl>{% for property in item.properties %}{% assign property_prefix = property.first | slice: 0 %}{% if property.last != blank and property_prefix != '_' %}<dt>{{ property.first | escape }}</dt><dd>{% if property.last contains '/uploads/' %}<a href="{{ property.last | escape }}">{{ property.last | split: '/' | last | escape }}</a>{% else %}{{ property.last | escape }}{% endif %}</dd>{% endif %}{% endfor %}</dl>{% endif %}<div class="cart-line__actions"><label class="visually-hidden" for="CartQuantity-{{ section.id }}-{{ item.key }}">{{ item.product.title | escape }} — {{ 'cart.general.quantity' | t }}</label><div class="quantity"><input id="CartQuantity-{{ section.id }}-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric"></div><a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a></div></div><div class="cart-line__price"><strong>{{ item.final_line_price | money }}</strong>{% if item.original_line_price > item.final_line_price %}<del>{{ item.original_line_price | money }}</del>{% endif %}{% for discount in item.line_level_discount_allocations %}<small>{{ discount.discount_application.title | escape }}</small>{% endfor %}</div></div>{% endfor %}</div><aside class="cart-page-summary" aria-label="{{ 'cart.general.subtotal' | t }}"><div class="cart-total"><span>{{ 'cart.general.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><p class="cart-shipping">{{ 'cart.general.shipping_at_checkout' | t }}</p>{% if settings.cart_note %}<label for="CartNote-{{ section.id }}">{{ 'cart.general.note' | t }}</label><textarea id="CartNote-{{ section.id }}" class="cart-note" name="note" rows="3">{{ cart.note | escape }}</textarea>{% endif %}<div class="cart-page-buttons"><button class="button button--primary" type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button><button class="button button--secondary" type="submit" name="update">{{ 'cart.general.update' | t }}</button><a class="button button--link" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a></div></aside></form>{% else %}<div class="cart-page-empty"><p>{{ 'cart.general.empty' | t }}</p><a class="button button--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a></div>{% endif %}</div></section>
{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "section_alignment",
      "label": "Section alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Standard"
        },
        {
          "value": "spacious",
          "label": "Generous"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Cart"
    }
  ],
  "enabled_on": {
    "templates": [
      "cart"
    ]
  }
}
{% endschema %}
