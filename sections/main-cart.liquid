<section class="section"><div class="page-width"><div class="section-heading"><h1>{{ 'cart.general.title' | t }}</h1></div>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-page-lines">{% for item in cart.items %}<div class="cart-line"><a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: width: 120, height: 150, alt: item.image.alt }}</a><div><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2><p>{{ item.variant.title }}</p><label for="CartQuantity-{{ item.key }}">{{ 'cart.general.quantity' | t }}</label><div class="quantity"><input id="CartQuantity-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><p><a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a></p></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><div class="cart-total" style="margin-top:2rem"><span>{{ 'cart.general.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div><label for="CartNote">{{ 'cart.general.note' | t }}</label><textarea id="CartNote" class="cart-note" name="note" rows="3">{{ cart.note }}</textarea><div style="margin-top:1rem"><button class="button button--secondary" type="submit" name="update">{{ 'cart.general.update' | t }}</button><button class="button button--primary" type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button></div></form>{% else %}<div class="card"><p>{{ 'cart.general.empty' | t }}</p><a class="button button--primary" href="{{ routes.root_url }}">{{ 'cart.general.continue_shopping' | t }}</a></div>{% endif %}</div></section>
{% schema %}{"name":"Cart","settings":[],"presets":[{"name":"Cart"}]}{% endschema %}
