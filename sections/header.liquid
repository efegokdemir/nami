<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}" data-header>
  <div class="page-width header-inner">
    <button class="icon-button mobile-only" type="button" aria-expanded="false" aria-controls="MobileNav" data-menu-toggle>{% render 'icon', name: 'menu' %}<span class="visually-hidden">{{ 'general.accessibility.menu' | t }}</span></button>
    <a class="wordmark" href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 560 | image_tag: widths: '160,280,560', sizes: '160px', width: settings.logo_width, alt: shop.name }}{% else %}Nami{% endif %}</a>
    <nav class="desktop-nav" aria-label="Primary">{% for link in section.settings.menu.links %}<div class="nav-item">{% if link.links != blank %}<details><summary>{{ link.title }}</summary><div class="mega-menu"><div class="mega-menu__links">{% for child in link.links %}<a href="{{ child.url }}">{{ child.title }}</a>{% for grandchild in child.links %}<a class="mega-menu__child" href="{{ grandchild.url }}">{{ grandchild.title }}</a>{% endfor %}{% endfor %}</div></div></details>{% else %}<a href="{{ link.url }}">{{ link.title }}</a>{% endif %}</div>{% endfor %}</nav>
    <div class="header-actions"><a class="icon-button" href="{{ routes.search_url }}" data-search-open>{% render 'icon', name: 'search' %}<span class="visually-hidden">{{ 'general.search.search' | t }}</span></a><a class="icon-button" href="{{ routes.cart_url }}" data-cart-open>{% render 'icon', name: 'cart' %}<span class="cart-count" data-cart-count>{{ cart.item_count }}</span><span class="visually-hidden">{{ 'general.accessibility.cart' | t }}</span></a></div>
  </div>
  <nav id="MobileNav" class="mobile-nav" hidden data-mobile-nav aria-label="Mobile"><div class="mobile-nav__inner"><button class="icon-button mobile-nav__close" type="button" data-menu-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span></button>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% for child in link.links %}<a class="mobile-nav__child" href="{{ child.url }}">{{ child.title }}</a>{% endfor %}{% endfor %}</div></nav>
  <div class="search-drawer" hidden data-predictive-search data-search-url="{{ routes.predictive_search_url }}"><div class="page-width"><form action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="PredictiveSearchInput">{{ 'general.search.search' | t }}</label><input id="PredictiveSearchInput" class="search-input" type="search" name="q" autocomplete="off" placeholder="{{ 'general.search.placeholder' | t }}" data-search-input><button class="icon-button" type="button" data-search-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span></button></form><div class="predictive-results" data-predictive-results></div></div></div>
</header>
{% schema %}{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},{"type":"checkbox","id":"sticky","label":"Sticky header","default":true}],"presets":[{"name":"Header"}]}{% endschema %}
