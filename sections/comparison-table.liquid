<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div><div class="comparison-table" role="table"><div class="comparison-table__row comparison-table__row--head" role="row"><div>{{ section.settings.feature_label }}</div>{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{{ block.settings.name }}</div>{% endfor %}</div><div class="comparison-table__row"><div>{{ section.settings.row_one }}</div>{% for block in section.blocks %}<div>{{ block.settings.row_one_value }}</div>{% endfor %}</div><div class="comparison-table__row"><div>{{ section.settings.row_two }}</div>{% for block in section.blocks %}<div>{{ block.settings.row_two_value }}</div>{% endfor %}</div><div class="comparison-table__row"><div>{{ section.settings.row_three }}</div>{% for block in section.blocks %}<div>{{ block.settings.row_three_value }}</div>{% endfor %}</div></div></div></section>
{% schema %}{"name":"Comparison table","max_blocks":4,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Compare the details"},{"type":"text","id":"feature_label","label":"Feature label","default":"Features"},{"type":"text","id":"row_one","label":"Row one","default":"Material"},{"type":"text","id":"row_two","label":"Row two","default":"Care"},{"type":"text","id":"row_three","label":"Row three","default":"Warranty"}],"blocks":[{"type":"column","name":"Column","settings":[{"type":"text","id":"name","label":"Column name","default":"Option"},{"type":"text","id":"row_one_value","label":"Row one value","default":"Details"},{"type":"text","id":"row_two_value","label":"Row two value","default":"Details"},{"type":"text","id":"row_three_value","label":"Row three value","default":"Details"}]}],"presets":[{"name":"Comparison table","blocks":[{"type":"column"},{"type":"column"}]}]}{% endschema %}
