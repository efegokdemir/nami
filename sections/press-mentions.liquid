<section class="section section--tight"><div class="page-width"><p class="eyebrow">{{ section.settings.heading }}</p><div class="press-list">{% for block in section.blocks %}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}><span>{{ block.settings.publication }}</span><strong>{{ block.settings.quote }}</strong></a>{% endfor %}</div></div></section>
{% schema %}{"name":"Press mentions","max_blocks":8,"settings":[{"type":"text","id":"heading","label":"Heading","default":"As seen in"}],"blocks":[{"type":"mention","name":"Mention","settings":[{"type":"text","id":"publication","label":"Publication","default":"Publication"},{"type":"text","id":"quote","label":"Mention","default":"A considered favorite."},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Press mentions","blocks":[{"type":"mention"},{"type":"mention"}]}]}{% endschema %}
