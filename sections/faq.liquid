<section class="section"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></div><div class="accordion">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="accordion__content">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>
{% schema %}{"name":"FAQ","max_blocks":12,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Good to know"},{"type":"text","id":"heading","label":"Heading","default":"Questions, answered."}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"What makes Nami different?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>It is calm, flexible and built around Shopify's native platform.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question"}]}]}{% endschema %}
