<section class="hero" {% if section.settings.image != blank %}style="--hero-overlay:{{ section.settings.overlay | divided_by: 100.0 }}"{% endif %}><div class="hero__media">{% render 'image', image: section.settings.image, width: 1800, sizes: '100vw', loading: 'eager', fetchpriority: 'high' %}</div><div class="hero__overlay"></div><div class="page-width hero__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p>{% if section.settings.button_label != blank %}<a class="button button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></section>
{% schema %}{"name":"Hero banner","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Nami / 01"},{"type":"text","id":"heading","label":"Heading","default":"Make room for what matters."},{"type":"textarea","id":"text","label":"Text","default":"A calm, considered foundation for your next chapter."},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"range","id":"overlay","label":"Image overlay","min":0,"max":80,"step":5,"default":30,"unit":"%"}],"presets":[{"name":"Hero banner"}]}{% endschema %}
