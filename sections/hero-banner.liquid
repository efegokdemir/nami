{% render 'section-style', section: section %}
<section class="section hero capability-hero capability-hero--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}" style="--hero-height:{{ section.settings.height }}px;--hero-mobile-height:{{ section.settings.mobile_height }}px;--hero-text-width:{{ section.settings.text_width }}px;--hero-overlay:{{ section.settings.overlay | divided_by: 100.0 }};--hero-overlay-color:{{ section.settings.overlay_color }};--hero-position:{{ section.settings.image_position }};--hero-valign:{{ section.settings.vertical_alignment }}">
  <div class="page-width capability-hero__layout{% if section.settings.media_position == 'right' %} media-right{% endif %} mobile-media-{{ section.settings.mobile_order }} height-{{ section.settings.height_mode }}">
    <div class="capability-hero__media">
      {% if section.settings.video != blank %}{{ section.settings.video | video_tag: image_size: '1600x', autoplay: section.settings.autoplay, loop: section.settings.loop, muted: true, controls: section.settings.controls }}
      {% elsif section.settings.image != blank %}<picture>{% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.image | image_url: width: 2000 | image_tag: widths: '480,750,1100,1500,2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}</picture>
      {% else %}{% render 'image' %}{% endif %}
      {% if section.settings.overlay_enabled %}<div class="capability-hero__overlay" aria-hidden="true"></div>{% endif %}
    </div>
    <div class="capability-hero__content align-{{ section.settings.alignment }} mobile-align-{{ section.settings.mobile_alignment }}">
      {% if section.settings.badge != blank %}<span class="content-badge">{{ section.settings.badge | escape }}</span>{% endif %}
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<{{ section.settings.heading_tag }}>{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>{% endif %}
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
      <div class="hero__actions">{% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="button button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}{% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "overlay",
          "label": "Full-bleed banner"
        },
        {
          "value": "split",
          "label": "Split"
        },
        {
          "value": "contained",
          "label": "Contained banner"
        }
      ],
      "default": "split"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video (muted)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Video controls",
      "default": true
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Media height",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed"
        },
        {
          "value": "natural",
          "label": "Adapt to image"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 320,
      "max": 800,
      "step": 20,
      "default": 560,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 240,
      "max": 640,
      "step": 20,
      "default": 360,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "focal",
          "label": "Image focal point"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "focal"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "Page heading"
        },
        {
          "value": "h2",
          "label": "Section heading"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical position",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text width",
      "min": 280,
      "max": 680,
      "step": 20,
      "default": 480,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position (split)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "overlay_enabled",
      "label": "Enable media overlay",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 30,
      "unit": "%",
      "visible_if": "{{ section.settings.overlay_enabled }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile image placement",
      "options": [
        {
          "value": "first",
          "label": "Above content"
        },
        {
          "value": "last",
          "label": "Below content"
        }
      ],
      "default": "first"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "spacious",
          "label": "Spacious"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Split hero",
      "settings": {
        "layout": "split"
      }
    },
    {
      "name": "Image banner",
      "settings": {
        "layout": "overlay",
        "overlay_enabled": true,
        "color_scheme": "scheme-3"
      }
    },
    {
      "name": "Contained hero",
      "settings": {
        "layout": "contained"
      }
    }
  ]
}
{% endschema %}
