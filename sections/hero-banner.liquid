{% render 'section-style', section: section %}
{% render 'hero', section: section %}
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "overlay",
          "label": "Full-bleed banner"
        },
        {
          "value": "split",
          "label": "Split"
        },
        {
          "value": "contained",
          "label": "Contained banner"
        }
      ],
      "default": "split"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video (muted)",
      "default": false,
      "visible_if": "{{ section.settings.video != blank }}"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": false,
      "visible_if": "{{ section.settings.video != blank }}"
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Video controls",
      "default": true,
      "visible_if": "{{ section.settings.video != blank }}"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Media height",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed"
        },
        {
          "value": "natural",
          "label": "Adapt to image"
        }
      ],
      "default": "fixed",
      "visible_if": "{{ section.settings.image != blank or section.settings.mobile_image != blank or section.settings.video != blank }}"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop minimum height",
      "min": 320,
      "max": 800,
      "step": 20,
      "default": 480,
      "unit": "px",
      "visible_if": "{{ section.settings.height_mode == 'fixed' and section.settings.image != blank or section.settings.mobile_image != blank or section.settings.video != blank }}"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile minimum height",
      "min": 240,
      "max": 640,
      "step": 20,
      "default": 240,
      "unit": "px",
      "visible_if": "{{ section.settings.height_mode == 'fixed' and section.settings.image != blank or section.settings.mobile_image != blank or section.settings.video != blank }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "focal",
          "label": "Image focal point"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "focal",
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "Page heading"
        },
        {
          "value": "h2",
          "label": "Section heading"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical position",
      "visible_if": "{{ section.settings.image != blank or section.settings.mobile_image != blank or section.settings.video != blank }}",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text width",
      "min": 280,
      "max": 680,
      "step": 20,
      "default": 480,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position (split)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right",
      "visible_if": "{{ section.settings.layout == 'split' and section.settings.image != blank or section.settings.mobile_image != blank or section.settings.video != blank }}"
    },
    {
      "type": "checkbox",
      "id": "overlay_enabled",
      "label": "Enable media overlay",
      "default": false,
      "visible_if": "{{ section.settings.image != blank or section.settings.mobile_image != blank or section.settings.video != blank }}"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 30,
      "unit": "%",
      "visible_if": "{{ section.settings.overlay_enabled }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000",
      "visible_if": "{{ section.settings.overlay_enabled }}"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile image placement",
      "options": [
        {
          "value": "first",
          "label": "Above content"
        },
        {
          "value": "last",
          "label": "Below content"
        }
      ],
      "default": "first",
      "visible_if": "{{ section.settings.layout == 'split' and section.settings.image != blank or section.settings.mobile_image != blank or section.settings.video != blank }}"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Standard"
        },
        {
          "value": "spacious",
          "label": "Generous"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Split hero",
      "settings": {
        "layout": "split"
      }
    },
    {
      "name": "Image banner",
      "settings": {
        "layout": "overlay",
        "overlay_enabled": true,
        "color_scheme": "scheme-3"
      }
    },
    {
      "name": "Contained hero",
      "settings": {
        "layout": "contained"
      }
    }
  ]
}
{% endschema %}
