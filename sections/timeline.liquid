<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div><ol class="timeline">{% for block in section.blocks %}<li {{ block.shopify_attributes }}><span class="eyebrow">{{ block.settings.date }}</span><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></li>{% endfor %}</ol></div></section>
{% schema %}{"name":"Timeline","max_blocks":8,"settings":[{"type":"text","id":"heading","label":"Heading","default":"How we got here"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"date","label":"Date or label","default":"01"},{"type":"text","id":"heading","label":"Heading","default":"A thoughtful beginning"},{"type":"textarea","id":"text","label":"Text","default":"Share a moment in your story."}]}],"presets":[{"name":"Timeline","blocks":[{"type":"step"},{"type":"step"},{"type":"step"}]}]}{% endschema %}
