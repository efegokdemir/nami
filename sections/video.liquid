<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.video != blank %}{{ section.settings.video | video_tag: image_size: '1400x', controls: true, autoplay: false, loop: false, muted: false }}{% elsif section.settings.cover != blank %}{{ section.settings.cover | image_url: width: 1600 | image_tag: widths: '640,1000,1600', sizes: '100vw', alt: section.settings.heading }}{% else %}<div class="card">Add a video or cover image.</div>{% endif %}</div></section>
{% schema %}{"name":"Video","settings":[{"type":"text","id":"heading","label":"Heading","default":"A closer look"},{"type":"video","id":"video","label":"Shopify-hosted video"},{"type":"image_picker","id":"cover","label":"Fallback cover image"}],"presets":[{"name":"Video"}]}{% endschema %}
