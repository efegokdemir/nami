<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div><div class="accordion" data-tabs>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="accordion__content">{{ block.settings.content }}</div></details>{% endfor %}</div></div></section>
{% schema %}{"name":"Collapsible content","max_blocks":12,"settings":[{"type":"text","id":"heading","label":"Heading","default":"More to explore"}],"blocks":[{"type":"tab","name":"Content item","settings":[{"type":"text","id":"heading","label":"Heading","default":"A little more detail"},{"type":"richtext","id":"content","label":"Content","default":"<p>Add useful information for customers.</p>"}]}],"presets":[{"name":"Collapsible content","blocks":[{"type":"tab"},{"type":"tab"}]}]}{% endschema %}
