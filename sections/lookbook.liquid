<section class="section"><div class="page-width lookbook"><div class="lookbook__image">{% render 'image', image: section.settings.image, width: 1800, sizes: '100vw' %}{% for block in section.blocks %}{% assign product = block.settings.product %}{% if product != blank %}<a class="hotspot" style="left:{{ block.settings.left }}%;top:{{ block.settings.top }}%" href="{{ product.url }}" aria-label="{{ product.title }}"><span aria-hidden="true">+</span><span class="hotspot__label">{{ product.title }}</span></a>{% endif %}{% endfor %}</div></div></section>
{% schema %}{"name":"Lookbook","max_blocks":8,"settings":[{"type":"image_picker","id":"image","label":"Lookbook image"}],"blocks":[{"type":"hotspot","name":"Product hotspot","settings":[{"type":"product","id":"product","label":"Product"},{"type":"range","id":"left","label":"Horizontal position","min":0,"max":100,"step":1,"default":50,"unit":"%"},{"type":"range","id":"top","label":"Vertical position","min":0,"max":100,"step":1,"default":50,"unit":"%"}]}],"presets":[{"name":"Lookbook"}]}{% endschema %}
