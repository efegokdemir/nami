{% assign collection = section.settings.collection %}<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2>{% if collection != blank %}<a class="button button--link" href="{{ collection.url }}">{{ section.settings.link_label }}</a>{% endif %}</div>{% if collection != blank %}<div class="product-scroll">{% for product in collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div>{% else %}<div class="card">Choose a collection to show products.</div>{% endif %}</div></section>
{% schema %}{"name":"Product carousel","settings":[{"type":"text","id":"heading","label":"Heading","default":"Worth a closer look"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":3,"max":10,"step":1,"default":5},{"type":"text","id":"link_label","label":"Link label","default":"View all"}],"presets":[{"name":"Product carousel"}]}{% endschema %}
