<footer class="site-footer color-{{ section.settings.color_scheme }}"><div class="page-width footer-grid">
<div class="footer-brand"><a class="wordmark" href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 420 | image_tag: width: 160, alt: shop.name }}{% else %}{{ shop.name | escape }}{% endif %}</a>{% if section.settings.text != blank %}<p class="footer-copy">{{ section.settings.text | escape }}</p>{% endif %}<div class="footer-social">{% assign social_names = 'instagram,facebook,tiktok,pinterest' | split: ',' %}{% for social in social_names %}{% assign social_key = social | append: '_url' %}{% if settings[social_key] != blank %}<a href="{{ settings[social_key] }}">{{ social | capitalize }}</a>{% endif %}{% endfor %}</div></div>
{% assign visible_menus = 0 %}{% for block in section.blocks %}{% if block.type == 'menu' and block.settings.menu != blank %}{% assign visible_menus = visible_menus | plus: 1 %}<div {{ block.shopify_attributes }}><h2 class="footer-title">{{ block.settings.heading | escape }}</h2><ul class="link-list">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></div>{% elsif block.type == 'newsletter' %}<div {{ block.shopify_attributes }}><h2 class="footer-title">{{ block.settings.heading | escape }}</h2>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail-{{ block.id }}">{{ block.settings.heading | escape }}</label><div class="form-row"><input id="FooterEmail-{{ block.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ block.settings.placeholder | escape }}"><button class="button button--primary" type="submit" aria-label="Subscribe">{% render 'icon', name: 'arrow' %}</button></div>{% if form.errors %}{{ form.errors | default_errors }}{% endif %}{% if form.posted_successfully? %}<p role="status">{{ 'sections.newsletter.success' | t }}</p>{% endif %}{% endform %}</div>{% endif %}{% endfor %}
{% if visible_menus == 0 %}<div><h2 class="footer-title">Explore</h2><ul class="link-list"><li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li><li><a href="{{ routes.search_url }}">{{ 'general.search.search' | t }}</a></li><li><a href="{{ routes.cart_url }}">{{ 'cart.general.title' | t }}</a></li></ul></div><div><h2 class="footer-title">Customer care</h2><ul class="link-list">{% if pages.contact != blank %}<li><a href="{{ pages.contact.url }}">Contact</a></li>{% endif %}{% for policy in shop.policies %}{% if policy != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}{% if shop.customer_accounts_enabled %}<li><a href="{{ routes.account_url }}">My account</a></li>{% endif %}<li><a href="{{ routes.root_url }}">{{ 'cart.general.continue_shopping' | t }}</a></li></ul></div>{% endif %}
</div><div class="page-width footer-bottom"><div><small>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</small><small>{{ powered_by_link }}</small></div><div class="footer-localization">{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}{% form 'localization' %}{% if localization.available_countries.size > 1 %}<label class="visually-hidden" for="FooterCountry">Country</label><select name="country_code" id="FooterCountry" onchange="this.form.submit()">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>{% endfor %}</select>{% endif %}{% if localization.available_languages.size > 1 %}<label class="visually-hidden" for="FooterLanguage">Language</label><select name="locale_code" id="FooterLanguage" onchange="this.form.submit()">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>{% endfor %}</select>{% endif %}<noscript><button type="submit">Update</button></noscript>{% endform %}{% endif %}</div><ul class="payment-methods" aria-label="Payment methods">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul></div></footer>
{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Keep in touch"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "Email address"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu"
        }
      ]
    }
  ]
}
{% endschema %}
