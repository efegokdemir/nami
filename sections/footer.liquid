<footer class="site-footer color-{{ section.settings.color_scheme }}"><div class="page-width footer-grid"><div><a class="wordmark" href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 420 | image_tag: width: 160, alt: shop.name }}{% else %}Nami{% endif %}</a>{% if section.settings.text != blank %}<p class="footer-copy">{{ section.settings.text }}</p>{% endif %}</div>{% for block in section.blocks %}{% if block.type == 'menu' %}<div {{ block.shopify_attributes }}><h2 class="footer-title">{{ block.settings.heading }}</h2>{% if block.settings.menu != blank %}<ul class="link-list">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>{% endif %}</div>{% elsif block.type == 'newsletter' %}<div {{ block.shopify_attributes }}><h2 class="footer-title">{{ block.settings.heading }}</h2>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail">{{ block.settings.heading }}</label><div class="form-row"><input id="FooterEmail" type="email" name="contact[email]" required placeholder="{{ block.settings.placeholder }}"><button class="button button--primary" type="submit">→</button></div>{% endform %}</div>{% endif %}{% endfor %}</div><div class="page-width footer-bottom"><small>© {{ 'now' | date: '%Y' }} {{ shop.name }}</small><small>{{ powered_by_link }}</small></div></footer>
{% schema %}{"name":"Footer","max_blocks":4,"settings":[{"type":"textarea","id":"text","label":"Intro text","default":"A calm, considered theme for modern commerce."},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}],"blocks":[{"type":"menu","name":"Menu","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu"}]},{"type":"newsletter","name":"Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Keep in touch"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Email address"}]}],"presets":[{"name":"Footer","blocks":[{"type":"menu"},{"type":"newsletter"}]}]}{% endschema %}
