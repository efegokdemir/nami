<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width rich-text"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button button--link" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></section>
{% schema %}{"name":"Rich text","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"Designed to leave space for the good things."},{"type":"richtext","id":"text","label":"Text","default":"<p>Build a storefront with clarity, warmth and room to grow.</p>"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}],"presets":[{"name":"Rich text"}]}{% endschema %}
