<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div><div class="stats-grid">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></div>{% endfor %}</div></div></section>
{% schema %}{"name":"Statistics","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Small numbers, meaningful details."}],"blocks":[{"type":"stat","name":"Statistic","settings":[{"type":"text","id":"value","label":"Value","default":"100%"},{"type":"text","id":"label","label":"Label","default":"Considered"}]}],"presets":[{"name":"Statistics","blocks":[{"type":"stat"},{"type":"stat"},{"type":"stat"}]}]}{% endschema %}
