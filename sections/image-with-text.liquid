<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width split{% if section.settings.reverse %} split--reverse{% endif %}"><div class="split__media">{% render 'image', image: section.settings.image, width: 1000, sizes: '(min-width: 750px) 50vw, 100vw' %}</div><div class="split__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></div></section>
{% schema %}{"name":"Image with text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"A quieter way to shop."},{"type":"richtext","id":"text","label":"Text","default":"<p>Tell your story with thoughtful details and a layout that gets out of the way.</p>"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"},{"type":"checkbox","id":"reverse","label":"Reverse layout"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}],"presets":[{"name":"Image with text"}]}{% endschema %}
