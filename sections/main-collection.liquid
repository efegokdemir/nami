{% paginate collection.products by 24 %}
<section class="section" data-collection-section><div class="page-width"><div class="section-heading"><div><p class="eyebrow">Collection</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</div><span>{{ collection.products_count }} products</span></div>
  <form class="collection-toolbar" method="get"><label for="SortBy">Sort by</label><select id="SortBy" name="sort_by" onchange="this.form.submit()"><option value="">Featured</option>{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select>{% if collection.filters.size > 0 %}<details class="filter-popover"><summary>Filter</summary><div class="filter-popover__panel">{% for filter in collection.filters %}<fieldset><legend>{{ filter.label }}</legend>{% case filter.type %}{% when 'list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> {{ value.label }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label for="{{ filter.min_value.param_name }}">Min</label><input id="{{ filter.min_value.param_name }}" name="{{ filter.min_value.param_name }}" type="number" value="{{ filter.min_value.value | money_without_currency }}"><label for="{{ filter.max_value.param_name }}">Max</label><input id="{{ filter.max_value.param_name }}" name="{{ filter.max_value.param_name }}" type="number" value="{{ filter.max_value.value | money_without_currency }}">{% endcase %}</fieldset>{% endfor %}<button class="button button--primary" type="submit">Apply filters</button></div></details>{% endif %}</form>
  {% if collection.filters.size > 0 %}<div class="active-filters">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label }} ×</a>{% endfor %}{% endfor %}{% if collection.current_vendor or collection.current_type %}<a href="{{ collection.url }}">Clear filters</a>{% endif %}</div>{% endif %}
  <div class="grid grid--products">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="card"><h2>No products found</h2><p>Try clearing a filter or exploring another collection.</p></div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{% if paginate.previous %}<a class="button button--secondary" href="{{ paginate.previous.url }}">Previous</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a class="button button--secondary" href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}</div></section>{% endpaginate %}
{% schema %}{"name":"Collection products","settings":[],"presets":[{"name":"Collection products"}]}{% endschema %}
