{% render 'section-style', section: section %}
{% paginate collection.products by section.settings.products_per_page %}
<section class="section" data-collection-section><div class="page-width">{% if section.settings.show_image and collection.image != blank %}{{ collection.image | image_url: width: 1600 | image_tag: widths: '640,1000,1600', sizes: '100vw', class: 'collection-banner', loading: 'eager' }}{% endif %}<div class="section-heading"><div><p class="eyebrow">Collection</p><h1>{{ collection.title }}</h1>{% if section.settings.show_description and collection.description != blank %}<div class="collection-description">{{ collection.description }}</div>{% endif %}</div><span>{{ collection.products_count }} products</span></div>
  <form class="collection-toolbar" method="get"><label for="SortBy">Sort by</label><select id="SortBy" name="sort_by" onchange="this.form.submit()"><option value="">Featured</option>{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select>{% if collection.filters.size > 0 %}<details class="filter-popover"><summary>Filter</summary><div class="filter-popover__panel">{% for filter in collection.filters %}<fieldset><legend>{{ filter.label }}</legend>{% case filter.type %}{% when 'list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> {{ value.label }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label for="{{ filter.min_value.param_name }}">Min</label><input id="{{ filter.min_value.param_name }}" name="{{ filter.min_value.param_name }}" type="number" value="{{ filter.min_value.value | divided_by: 100.0 }}"><label for="{{ filter.max_value.param_name }}">Max</label><input id="{{ filter.max_value.param_name }}" name="{{ filter.max_value.param_name }}" type="number" value="{{ filter.max_value.value | divided_by: 100.0 }}">{% endcase %}</fieldset>{% endfor %}<button class="button button--primary" type="submit">Apply filters</button></div></details>{% endif %}</form>
  {% if collection.filters.size > 0 %}<div class="active-filters">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label }} ×</a>{% endfor %}{% endfor %}{% if collection.current_vendor or collection.current_type %}<a href="{{ collection.url }}">Clear filters</a>{% endif %}</div>{% endif %}
  <div class="merch-grid" style="--desktop-columns:{{ section.settings.desktop_columns }};--mobile-columns:{{ section.settings.mobile_columns }}">{% for product in collection.products %}{% render 'product-card', product: product, show_vendor: section.settings.show_vendor, show_price: section.settings.show_price, show_badges: section.settings.show_badges, show_second_image: section.settings.show_second_image, show_quick_add: section.settings.show_quick_add, show_swatches: section.settings.show_swatches, image_ratio: section.settings.image_ratio, card_style: section.settings.card_style, card_alignment: section.settings.card_alignment %}{% else %}<div class="card"><h2>No products found</h2><p>Try clearing a filter or exploring another collection.</p></div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{% if paginate.previous %}<a class="button button--secondary" href="{{ paginate.previous.url }}">Previous</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a class="button button--secondary" href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}</div></section>{% endpaginate %}
{% schema %}
{
  "name": "Collection products",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "section_alignment",
      "label": "Section alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "spacious",
          "label": "Spacious"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show option swatches",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image proportions",
      "options": [
        {
          "value": "natural",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "surface",
          "label": "Surface"
        }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection products"
    }
  ]
}
{% endschema %}
