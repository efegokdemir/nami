{% assign blog = section.settings.blog %}<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2>{% if blog != blank %}<a class="button button--link" href="{{ blog.url }}">{{ section.settings.link_label }}</a>{% endif %}</div>{% if blog != blank %}<div class="grid grid--columns">{% for article in blog.articles limit: section.settings.limit %}<article class="card">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: widths: '320,640,900', sizes: '(min-width: 750px) 33vw, 100vw', alt: article.title }}{% endif %}<p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p><h3><a href="{{ article.url }}">{{ article.title }}</a></h3><p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p></article>{% endfor %}</div>{% else %}<div class="card">Choose a blog to feature articles.</div>{% endif %}</div></section>
{% schema %}{"name":"Featured blog","settings":[{"type":"text","id":"heading","label":"Heading","default":"From the journal"},{"type":"blog","id":"blog","label":"Blog"},{"type":"range","id":"limit","label":"Articles","min":1,"max":6,"step":1,"default":3},{"type":"text","id":"link_label","label":"Link label","default":"View all"}],"presets":[{"name":"Featured blog"}]}{% endschema %}
