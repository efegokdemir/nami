{% paginate blog.articles by 24 %}
{% render 'section-style', section: section %}
<section class="section blog-section"><div class="page-width"><div class="section-heading"><h1>{{ blog.title | escape }}</h1></div><div class="journal-grid">{% for article in blog.articles %}<article class="journal-card">{% if article.image %}<a class="journal-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">{% render 'image', image: article.image, width: 1000, sizes: '(min-width:750px) 33vw,100vw' %}</a>{% endif %}<p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p><h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | replace: "</p>", " " | replace: "</h2>", " " | replace: "</h3>", " " | strip_html | strip | truncate: 180 | escape }}</p></article>{% else %}{% if request.design_mode %}<p class="editor-help">Published articles appear here.</p>{% else %}<p class="empty-state">No articles yet.</p>{% endif %}{% endfor %}</div></div></section>
{% if paginate.pages > 1 %}<nav class="page-width pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}
{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "section_alignment",
      "label": "Section alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Standard"
        },
        {
          "value": "spacious",
          "label": "Generous"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Blog"
    }
  ],
  "enabled_on": {
    "templates": [
      "blog"
    ]
  }
}
{% endschema %}
