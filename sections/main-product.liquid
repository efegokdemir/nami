<section class="section" data-product-section>
  <div class="page-width split">
    <div class="product-gallery">
      {% for media in product.media %}
        <div class="split__media product-gallery__item">{% if media.media_type == 'video' or media.media_type == 'external_video' %}{{ media | media_tag: image_size: '1200x', controls: true, preload: 'metadata' }}{% else %}{{ media.preview_image | image_url: width: 1200 | image_tag: widths: '480,800,1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}{% endif %}</div>
      {% else %}<div class="media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>{% endfor %}
    </div>
    <div class="split__content product-information">
      <p class="eyebrow">{{ product.vendor }}</p><h1>{{ product.title }}</h1>
      <div class="price" data-product-price>{{ product.selected_or_first_available_variant.price | money }} {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<del>{{ product.selected_or_first_available_variant.compare_at_price | money }}</del>{% endif %}</div>
      <div class="product-description">{{ product.description }}</div>
      {% form 'product', product, data-add-to-cart: '', data-product-form: '' %}
        {% unless product.has_only_default_variant %}<fieldset class="product-options"><legend class="visually-hidden">Options</legend>{% for option in product.options_with_values %}<label for="Option-{{ section.id }}-{{ forloop.index }}">{{ option.name }}</label><select id="Option-{{ section.id }}-{{ forloop.index }}" name="options[{{ option.name }}]" data-product-option>{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>{% endfor %}</select>{% endfor %}</fieldset>{% endunless %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id><label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label><div class="quantity"><button type="button" data-quantity-minus aria-label="Decrease quantity">−</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" data-product-quantity><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div><button class="button button--primary" type="submit" data-add-to-cart-button{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>{% if section.settings.dynamic_checkout %}{{ form | payment_button }}{% endif %}
      {% endform %}
      {% if section.settings.size_guide_page != blank %}<details class="size-guide"><summary>{{ section.settings.size_guide_label }}</summary><div class="accordion__content">{{ section.settings.size_guide_page.content }}</div></details>{% endif %}
      <div class="accordion"><details open><summary>Details</summary><div class="accordion__content">{{ section.settings.details }}</div></details>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="accordion__content">{{ block.settings.content }}</div></details>{% endfor %}</div>
      {% if section.settings.sticky_atc %}<div class="sticky-atc" data-sticky-atc><span>{{ product.title }}</span><button class="button button--primary" type="button" data-sticky-submit>{{ 'products.product.add_to_cart' | t }}</button></div>{% endif %}
    </div>
  </div><script type="application/json" data-product-json>{{ product | json }}</script>
</section>
{% schema %}{"name":"Product","settings":[{"type":"richtext","id":"details","label":"Details","default":"<p>Add materials, care and shipping information here.</p>"},{"type":"checkbox","id":"dynamic_checkout","label":"Show accelerated checkout","default":true},{"type":"checkbox","id":"sticky_atc","label":"Sticky add to cart","default":false},{"type":"page","id":"size_guide_page","label":"Size guide page"},{"type":"text","id":"size_guide_label","label":"Size guide label","default":"Size guide"}],"blocks":[{"type":"info","name":"Information","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shipping & returns"},{"type":"richtext","id":"content","label":"Content","default":"<p>Share your policy details.</p>"}]},{"type":"@app"}],"presets":[{"name":"Product"}]}{% endschema %}
