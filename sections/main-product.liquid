{% render 'section-style', section: section %}
<section class="section product-section color-{{ section.settings.color_scheme }}" data-product-section><div class="page-width product-layout media-{{ section.settings.media_position }}" style="--media-width:{{ section.settings.media_width }}%">{% render 'product-media', product: product, section: section %}{% render 'product-information', product: product, section: section, is_main: true %}</div><script type="application/json" data-product-json>{% render 'product-data', product: product %}</script></section>
{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "thumbnails",
          "label": "Thumbnails"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Desktop media width",
      "min": 45,
      "max": 65,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "dynamic_checkout",
      "label": "Show accelerated checkout",
      "default": true,
      "info": "Used only when there are no information blocks. Otherwise configure the Buy buttons block."
    },
    {
      "type": "checkbox",
      "id": "sticky_atc",
      "label": "Mobile sticky Add to Cart",
      "default": false
    },
    {
      "type": "richtext",
      "id": "details",
      "label": "Legacy details"
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "Size guide page"
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Size guide label",
      "default": "Size guide"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "spacious",
          "label": "Spacious"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "checkbox",
          "id": "short",
          "label": "Use short description",
          "default": true
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "settings": [
        {
          "type": "select",
          "id": "picker_style",
          "label": "Option style",
          "options": [
            {
              "value": "dropdown",
              "label": "Dropdown"
            },
            {
              "value": "buttons",
              "label": "Buttons"
            },
            {
              "value": "swatches",
              "label": "Swatches"
            }
          ],
          "default": "dropdown"
        },
        {
          "type": "checkbox",
          "id": "image_swatches",
          "label": "Use variant images when available",
          "default": false
        }
      ],
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "Quantity",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "settings": [
        {
          "type": "checkbox",
          "id": "dynamic_checkout",
          "label": "Show accelerated checkout",
          "default": true
        }
      ],
      "limit": 1
    },
    {
      "type": "inventory",
      "name": "Inventory status",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_count",
          "label": "Show inventory count",
          "default": false
        }
      ],
      "limit": 1
    },
    {
      "type": "sku",
      "name": "SKU",
      "limit": 1
    },
    {
      "type": "info",
      "name": "Collapsible details",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        }
      ]
    },
    {
      "type": "popup",
      "name": "Page disclosure",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link label"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    },
    {
      "type": "complementary",
      "name": "Complementary products",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "range",
          "id": "limit",
          "label": "Products",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 2
        }
      ]
    },
    {
      "type": "share",
      "name": "Share link",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        {
          "type": "vendor"
        },
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "description"
        },
        {
          "type": "variant_picker"
        },
        {
          "type": "quantity"
        },
        {
          "type": "buy_buttons"
        }
      ]
    }
  ]
}
{% endschema %}
