<article class="section"><div class="page-width rich-text"><p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p><h1>{{ article.title }}</h1>{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: widths: '640,1000,1400', sizes: '100vw', loading: 'eager' }}{% endif %}<div>{{ article.content }}</div></div></article>
{% schema %}{"name":"Article","settings":[],"presets":[{"name":"Article"}]}{% endschema %}
