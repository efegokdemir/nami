{% render 'section-style', section: section, reading_width: 720 %}
<article class="section"><div class="page-width rich-text"><p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p><h1>{{ article.title }}</h1>{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: widths: '640,1000,1400', sizes: '100vw', loading: 'eager' }}{% endif %}<div>{{ article.content }}</div></div></article>
{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Standard"
        },
        {
          "value": "spacious",
          "label": "Generous"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Article"
    }
  ],
  "enabled_on": {
    "templates": [
      "article"
    ]
  }
}
{% endschema %}
