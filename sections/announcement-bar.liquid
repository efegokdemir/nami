{% if section.settings.text != blank %}<div class="announcement color-{{ section.settings.color_scheme }}"><div class="page-width">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>{% else %}{{ section.settings.text | escape }}{% endif %}</div></div>{% endif %}
{% schema %}{"name":"Announcement bar","settings":[{"type":"inline_richtext","id":"text","label":"Message","default":"Thoughtful goods for everyday living"},{"type":"url","id":"link","label":"Link"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"}],"presets":[{"name":"Announcement bar"}]}{% endschema %}
