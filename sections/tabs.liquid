{% assign meaningful = 0 %}{% for block in section.blocks %}{% if block.settings.heading != blank %}{% if block.settings.content != blank or block.settings.page.content != blank or block.settings.custom_liquid != blank %}{% assign meaningful = meaningful | plus: 1 %}{% endif %}{% endif %}{% endfor %}
{% if meaningful > 0 or request.design_mode %}{% render 'section-style', section: section %}<section class="section color-{{ section.settings.color_scheme }}"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2></div>
{% if meaningful > 0 %}<div class="tabs" data-tabs><div class="tabs__buttons" role="tablist" aria-label="{{ section.settings.heading | default: 'Content' | escape }}">{% assign item_index = 0 %}{% for block in section.blocks %}{% if block.settings.heading != blank %}{% if block.settings.content != blank or block.settings.page.content != blank or block.settings.custom_liquid != blank %}<button id="Tab-{{ section.id }}-{{ block.id }}" type="button" role="tab" aria-selected="{% if item_index == 0 %}true{% else %}false{% endif %}" tabindex="{% if item_index == 0 %}0{% else %}-1{% endif %}" aria-controls="TabPanel-{{ section.id }}-{{ block.id }}" data-tab-button {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</button>{% assign item_index = item_index | plus: 1 %}{% endif %}{% endif %}{% endfor %}</div>
{% assign item_index = 0 %}{% for block in section.blocks %}{% if block.settings.heading != blank %}{% if block.settings.content != blank or block.settings.page.content != blank or block.settings.custom_liquid != blank %}<div id="TabPanel-{{ section.id }}-{{ block.id }}" aria-labelledby="Tab-{{ section.id }}-{{ block.id }}" role="tabpanel" tabindex="0" data-tab-panel{% unless item_index == 0 %} hidden{% endunless %}>{{ block.settings.content }}{{ block.settings.page.content }}{{ block.settings.custom_liquid }}</div>{% assign item_index = item_index | plus: 1 %}{% endif %}{% endif %}{% endfor %}</div>
{% elsif request.design_mode %}<p class="editor-help">Add a labelled tab with content.</p>{% endif %}</div></section>{% endif %}
{% schema %}
{
  "name": "Tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.section_width == 'page' }}"
    },
    {
      "type": "select",
      "id": "section_alignment",
      "label": "Section alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "normal",
          "label": "Standard"
        },
        {
          "value": "spacious",
          "label": "Generous"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Custom top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Custom bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.spacing == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab label",
          "default": "Tab"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page content"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabs",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}
