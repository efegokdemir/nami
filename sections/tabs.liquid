<section class="section"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2></div><div class="tabs" data-tabs><div class="tabs__buttons" role="tablist">{% for block in section.blocks %}<button type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="TabPanel-{{ section.id }}-{{ forloop.index }}" data-tab-button {{ block.shopify_attributes }}>{{ block.settings.heading }}</button>{% endfor %}</div>{% for block in section.blocks %}<div id="TabPanel-{{ section.id }}-{{ forloop.index }}" role="tabpanel" data-tab-panel{% unless forloop.first %} hidden{% endunless %}>{{ block.settings.content }}</div>{% endfor %}</div></div></section>
{% schema %}{"name":"Tabs","max_blocks":8,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore the details"}],"blocks":[{"type":"tab","name":"Tab","settings":[{"type":"text","id":"heading","label":"Tab label","default":"Details"},{"type":"richtext","id":"content","label":"Content","default":"<p>Add useful content for this tab.</p>"}]}],"presets":[{"name":"Tabs","blocks":[{"type":"tab"},{"type":"tab"}]}]}{% endschema %}
